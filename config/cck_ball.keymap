#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

// マウスボタン押下でautomouseレイヤー（Layer 3）を延長

&mkp_input_listener {
    input-processors = <&zip_temp_layer 3 500>;  // Layer 3を500ms延長
};

// automouseレイヤー設定（トラックボール移動で有効化）

&zip_temp_layer {
    excluded-positions = <
        // Layer 3の右側マウスボタンの位置
        // Row 1 (0-indexed): MB4=6, MB5=7
        // Row 2: LCLK=18, MCLK=19
        // Row 3: LCLK=30, RCLK=31, mo 5=32
        // Row 5: LCLK=52, RCLK=53
        6 7 18 19 30 31 32 52 53
    >;
};

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&lt {
    tapping-term-ms = <200>;  // Layer Tap response time (default: 200ms)
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // Middle click on tap, Layer 5 (scroll) on hold

        lt_mclk: layer_tap_middle_click {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default

        QWERTY {
            bindings = <
&lt 7 TAB         &kp N1        &kp N2        &kp N3     &kp N4       &kp N5       &kp N6       &kp N7  &kp N8     &kp N9   &kp N0      &kp BACKSPACE
&lt 7 TAB         &kp Q         &kp W         &kp E      &kp R        &kp T        &kp Y        &kp U   &kp I      &kp O    &kp P       &kp BACKSPACE
&kp LEFT_SHIFT    &kp A         &kp S         &kp D      &kp F        &kp G        &kp H        &kp J   &kp K      &kp L    &lt 5 SEMI  &kp ENTER
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V        &kp B        &kp N        &kp M   &kp COMMA  &kp DOT  &kp SLASH   &kp LEFT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 8 ESC  &lt 5 SPACE  &lt 5 LANG1  &lt 6 LANG2  &mo 4   &tog 1     &none    &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 1: Gaming

        layer_1 {
            bindings = <
&kp TAB    &kp N1        &kp N2    &kp N3         &kp N4     &kp N5         &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q         &kp W     &kp E          &kp R      &kp T          &kp Y   &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A         &kp S     &lt 2 D        &kp F      &kp G          &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp RET
&kp LSHFT  &kp Z         &kp X     &kp C          &kp V      &kp B          &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp FSLH
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &kp LC(SPACE)  &kp SPACE  &kp LS(SPACE)  &to 0   &kp LS(Y)  &trans     &trans   &trans    &to 0
            >;
        };

        // Layer 2: Gaming Sub

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans         &kp LA(LCTRL)  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LS(LC(Z))  &kp LC(Z)      &kp LC(GRAVE)  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Layer 3: Mouse Active Layer (Auto Mouse) & Functions

        F_layers {
            bindings = <
&trans  &trans  &trans  &trans        &trans  &trans  &mkp MB4   &mkp MB5         &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans  &trans  &mkp LCLK  &lt_mclk 5 MCLK  &trans  &trans  &trans  &trans
&trans  &none   &trans  &kp CAPSLOCK  &none   &none   &mkp MB3   &mkp RCLK        &mo 5   &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans  &none   &none      &none            &none   &trans  &none   &trans
&trans  &trans  &trans  &trans        &trans  &trans  &trans     &trans           &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 4: Bluetooth

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans    &trans    &trans         &trans   &bt BT_CLR
&trans  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6      &kp N7    &kp N8    &kp N9         &kp N0   &trans
&trans  &kp UNDER     &kp MINUS     &kp LBRC      &kp RBRC      &trans        &trans      &kp LPAR  &kp RPAR  &kp BACKSLASH  &kp SQT  &trans
&trans  &kp EQUAL     &kp PLUS      &kp LBKT      &kp RBKT      &trans        &bt BT_NXT  &kp LT    &kp GT    &kp SLASH      &kp DQT  &trans
&trans  &kp EQUAL     &trans        &trans        &trans        &trans        &trans      &trans    &trans    &trans         &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 5: Scroll Layer (with Nav/Click keys)

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans  &trans     &trans    &trans    &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &kp PG_UP  &kp HOME  &kp UP    &kp END    &trans  &trans
&trans  &none   &none   &kp CAPS   &trans     &trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &none   &none      &none     &trans    &trans     &none   &trans
&trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans     &trans    &trans    &trans     &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 6: Snipe / Symbols

        snipe-layers {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans     &trans     &trans     &trans     &trans    &bt BT_CLR
&trans  &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR  &trans
&trans  &trans        &kp GRAVE     &kp PLUS      &mo 5         &trans        &trans     &kp FSLH   &kp ASTRK  &kp EQUAL  &kp PIPE  &trans
&trans  &trans        &kp TILDE     &kp PIPE      &trans        &trans        &trans     &kp PRCNT  &kp AMPS   &trans     &trans    &trans
&trans  &trans        &trans        &trans        &mkp LCLK     &mkp RCLK     &trans     &trans     &trans     &trans     &trans    &trans
            >;

            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        // Layer 7: Function Keys

        layer_7 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans     &trans     &trans     &trans     &trans    &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &kp INS  &trans     &kp FSLH   &kp ASTRK  &kp EQUAL  &kp PIPE  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans     &kp PRCNT  &kp AMPS   &trans     &trans    &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans     &trans     &trans     &trans     &trans    &trans
            >;

            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        // Layer 8: Application & Window Control

        layer_8 {
            bindings = <
&trans  &trans           &trans        &trans         &trans        &trans  &trans         &trans            &trans        &trans             &trans     &trans
&trans  &none            &kp C_VOL_DN  &kp C_MUTE     &kp C_VOL_UP  &none   &kp LC(LG(T))  &kp LG(LEFT)      &kp LG(UP)    &kp LG(RIGHT)      &none      &trans
&trans  &kp LC(LS(ESC))  &kp LS(TAB)   &kp LALT       &kp TAB       &none   &none          &kp LC(LG(LEFT))  &kp LG(DOWN)  &kp LC(LG(RIGHT))  &kp PSCRN  &trans
&trans  &none            &trans        &kp LA(SPACE)  &none         &none   &none          &none             &kp LG(TAB)   &none              &none      &trans
&trans  &trans           &trans        &trans         &trans        &trans  &trans         &trans            &trans        &trans             &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 9

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans        &trans  &trans  &trans         &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans        &trans  &trans  &kp PG_UP      &kp HOME        &kp UP_ARROW    &kp END          &trans  &trans
&trans  &trans  &trans  &kp CAPSLOCK  &trans  &trans  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans        &trans  &trans  &trans         &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans        &trans  &trans  &trans         &trans          &trans          &trans           &trans  &trans
            >;
        };
    };
};
