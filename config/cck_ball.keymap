#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // 左右滚动编码器行为
    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default
        QWERTY {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3        &kp N4        &kp N5         &kp N6        &kp N7        &kp N8        &kp N9            &kp N0            &kp BACKSPACE
&lt 5 TAB         &kp Q         &kp W         &kp E         &kp R         &kp T          &kp Y         &kp U         &kp I         &kp O             &kp P             &kp BACKSPACE
&kp LEFT_SHIFT    &kp A         &lt 4 S       &kp D         &lt 3 F       &kp G          &kp H         &kp J         &kp K         &kp L             &kp SEMI          &kp ENTER
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B          &kp N         &kp M         &kp COMMA     &kp DOT           &none             &kp LEFT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 DELETE  &lt 1 SPACE   &lt 3 LANG1    &lt 4 LANG2   &mo 2         &kp ENTER     &none             &none             &tog 1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 1: Mouse Active Layer (Auto Mouse) & Functions
        F_layers {
            bindings = <
&trans   &trans          &trans        &trans        &trans        &trans         &trans        &trans      &trans      &trans     &trans   &trans
&trans   &trans          &trans        &trans        &trans        &trans         &kp PG_UP     &kp HOME    &kp UP      &kp END    &trans   &bt BT_CLR
&trans   &none           &trans        &kp CAPSLOCK  &none         &none          &kp PG_DN     &kp LEFT    &kp DOWN    &kp RIGHT  &trans   &trans
&trans   &trans          &trans        &trans        &trans        &none          &none         &none       &trans      &trans     &none    &trans
&trans   &trans          &trans        &trans        &mkp LCLK     &mkp RCLK      &trans        &trans      &trans      &trans     &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 2: Bluetooth
        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans         &trans        &trans      &trans  &trans  &trans
&trans  &kp N1          &kp N2        &kp N3        &kp N4        &kp N5          &kp N6         &kp N7        &kp N8      &kp N9  &kp N0  &trans
&trans  &kp UNDER       &kp MINUS     &kp LBRC      &kp RBRC      &trans          &trans         &kp LPAR      &kp RPAR    &trans  &trans  &trans
&trans  &kp EQUAL       &kp PLUS      &kp LBKT      &kp RBKT      &trans          &bt BT_NXT     &kp LT        &kp GT      &trans  &trans  &trans
&trans  &kp EQUAL       &trans        &trans        &trans        &trans          &trans         &trans        &trans      &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 3: Scroll Layer (with Nav/Click keys)
        scroll-layers {
            bindings = <
&trans   &trans          &trans        &trans        &trans        &trans         &trans        &trans      &trans      &trans     &trans   &trans
&trans   &trans          &trans        &trans        &trans        &trans         &kp PG_UP     &kp HOME    &kp UP      &kp END    &trans   &trans
&trans   &none           &none         &trans        &trans        &trans         &kp PG_DN     &kp LEFT    &kp DOWN    &kp RIGHT  &trans   &trans
&trans   &trans          &trans        &trans        &trans        &none          &none         &none       &trans      &trans     &none    &trans
&trans   &trans          &trans        &mkp LCLK     &mkp RCLK     &trans         &trans        &trans      &trans      &trans     &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Layer 4: Snipe / Symbols
        snipe-layers {
            bindings = <
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &trans      &trans     &trans    &trans    &trans
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET   &kp AMPS    &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &trans    &trans  &trans    &mo 3     &trans     &trans      &kp FSLH    &kp ASTRK  &kp EQUAL &kp PIPE  &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &kp PRCNT   &kp AMPS   &trans    &trans    &trans
&trans  &trans    &trans  &trans    &mkp LCLK &mkp RCLK  &trans      &trans      &trans     &trans    &trans    &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        // Layer 5: Function Keys
        layer_5 {
            bindings = <
&trans  &kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &trans      &trans      &trans     &trans    &trans    &trans
&trans  &kp F6    &kp F7  &kp F8    &kp F9    &kp F10    &kp CARET   &kp AMPS    &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans  &kp F11   &kp F12 &trans    &trans    &kp INS    &trans      &kp FSLH    &kp ASTRK  &kp EQUAL &kp PIPE  &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &kp PRCNT   &kp AMPS   &trans    &trans    &trans
&trans  &trans    &trans  &trans    &trans    &trans     &trans      &trans      &trans     &trans    &trans    &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        // Layer 6: Application & Window Control
        layer_6 {
            bindings = <
// ┌──────────┬──────────────┬─────────────┬──────────────┬──────────────┬──────┬──────────────┬──────────────────┬──────────────┬──────────────────┬───────────┬──────────┐
   &trans      &trans         &trans        &trans         &trans         &trans &trans         &trans             &trans         &trans             &trans      &trans
// ├──────────┼──────────────┼─────────────┼──────────────┼──────────────┼──────┼──────────────┼──────────────────┼──────────────┼──────────────────┼───────────┼──────────┤
   &trans      &none          &kp C_VOL_DN  &kp C_MUTE     &kp C_VOL_UP   &none  &kp LC(LG(T))  &kp LG(LEFT)       &kp LG(UP)     &kp LG(RIGHT)      &none       &trans
// │          │              │ Volume Down │ Mute         │ Volume Up    │      │ New Desktop  │ Win + Left       │ Win + Up     │ Win + Right      │           │          │
// ├──────────┼──────────────┼─────────────┼──────────────┼──────────────┼──────┼──────────────┼──────────────────┼──────────────┼──────────────────┼───────────┼──────────┤
   &trans      &kp LC(LS(ESC)) &kp LS(TAB)  &kp LALT       &kp TAB        &none  &none          &kp LC(LG(LEFT))   &kp LG(DOWN)   &kp LC(LG(RIGHT))  &kp PSCRN   &trans
// │          │ Task Manager │ Shift+Tab   │ Alt          │ Tab          │      │              │ Desktop Left     │ Win + Down   │ Desktop Right    │ PrtScr    │          │
// ├──────────┼──────────────┼─────────────┼──────────────┼──────────────┼──────┼──────────────┼──────────────────┼──────────────┼──────────────────┼───────────┼──────────┤
   &trans      &none          &trans        &kp LA(SPACE)  &none          &none  &none          &none              &kp LG(TAB)    &none              &none       &trans
// │          │              │             │ Alt+Space    │              │      │              │                  │ Win + Tab    │                  │           │          │
// ├──────────┼──────────────┼─────────────┼──────────────┼──────────────┼──────┼──────────────┼──────────────────┼──────────────┼──────────────────┼───────────┼──────────┤
   &trans      &trans         &trans        &trans         &trans         &trans &trans         &trans             &trans         &trans             &trans      &trans
// └──────────┴──────────────┴─────────────┴──────────────┴──────────────┴──────┴──────────────┴──────────────────┴──────────────┴──────────────────┴───────────┴──────────┘
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
